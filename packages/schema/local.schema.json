{
  "$defs": {
    "PermissionRule": {
      "additionalProperties": false,
      "description": "권한 규칙 하나. rule은 \"도구\" 또는 \"도구(인자 패턴)\". 도구·인자 모두 glob(*, ?), 대소문자 구분",
      "properties": {
        "rule": {
          "pattern": "^[a-z0-9_*?]+(\\(.*\\))?$",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/PermissionVerdict"
        }
      },
      "required": ["rule", "verdict"],
      "title": "PermissionRule",
      "type": "object"
    },
    "PermissionVerdict": {
      "enum": ["allow", "ask", "deny"],
      "title": "PermissionVerdict"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "에이전트 권한 (프로젝트 계층). 툴셋·프리셋 값이 사용자 설정보다 먼저다",
      "properties": {
        "preset": {
          "enum": ["explorer", "full", "graph_author", "read_only", "runner"]
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "type": "array"
        },
        "toolsets": {
          "additionalProperties": {
            "$ref": "#/$defs/PermissionVerdict"
          },
          "propertyNames": {
            "enum": ["control", "core", "graph_edit", "observe", "run", "screens"]
          },
          "type": "object"
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "PluginIndex": {
      "additionalProperties": false,
      "description": "M6: 플러그인 의존성 인덱스. kookabug.json은 팀 공용, .kookabug/local.json의 같은 키가 개인 덮어쓰기. URL의 사용자 정보는 잠금·로그·화면에 남기지 않는다",
      "properties": {
        "find_links": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "PluginIndex",
      "type": "object"
    },
    "PluginTrust": {
      "additionalProperties": false,
      "description": "M6: 이 PC에서 사람이 신뢰 확인한 kookabug.lock의 정규 잠금 해시들 (같은 잠금이면 다시 묻지 않는다, 오래된 것부터 버림)",
      "properties": {
        "locks": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "title": "PluginTrust",
      "type": "object"
    },
    "SettingKey": {
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "title": "SettingKey",
      "type": "string"
    },
    "Settings": {
      "description": "설정 키 → 값. 여기 있는 키는 프로필·기본값보다 먼저 쓴다 (null도 선택된 값)",
      "propertyNames": {
        "$ref": "#/$defs/SettingKey"
      },
      "title": "Settings",
      "type": "object"
    }
  },
  "$id": "urn:kookabug:local:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "개인 설정 (.kookabug/local.json, Git 제외)",
  "properties": {
    "format": {
      "const": "kookabug.local/0"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "plugin_index": {
      "$ref": "#/$defs/PluginIndex"
    },
    "plugin_trust": {
      "$ref": "#/$defs/PluginTrust"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "sources": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["path"],
        "title": "LocalSource",
        "type": "object"
      },
      "description": "M8: 이 PC의 원본 경로 (kookabug.json sources[].local: true인 원본)",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
      },
      "type": "object"
    }
  },
  "required": ["format"],
  "title": "Local",
  "type": "object"
}
