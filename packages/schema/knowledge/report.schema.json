{
  "$id": "urn:kookabug:report:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "작업 보고 knowledge/reports/<작업 ID>.json (M8 계획 3.11). 항목은 Kookabug가 작업의 구조화 기록에서 만들고 Agent 글은 notes 하나",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "runs": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "ended_at": {
      "anyOf": [
        {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "const": "kookabug.report/0"
    },
    "groups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cause": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "decision": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "maxLength": 40,
                    "minLength": 1,
                    "type": "string"
                  },
                  "by": {
                    "const": "human"
                  },
                  "decision": {
                    "enum": ["accept", "reject"]
                  }
                },
                "required": ["at", "by", "decision"],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "adoption": {
                  "pattern": "^a-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
                  "type": "string"
                },
                "case": {
                  "pattern": "^c-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
                  "type": "string"
                },
                "change": {
                  "pattern": "^w-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
                  "type": "string"
                },
                "cheat": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "checks": {
                  "items": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "claims": {
                  "items": {
                    "$ref": "urn:kookabug:claims:0#/$defs/ClaimRef"
                  },
                  "type": "array"
                },
                "detail": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                },
                "evidence": {
                  "pattern": "^[a-z][a-z0-9-]{0,95}$",
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "auto_adopted",
                    "budget",
                    "cheat_candidate",
                    "init_summary",
                    "prep_failed",
                    "regression_suspect",
                    "setting_change",
                    "stalled",
                    "undetermined",
                    "working_only"
                  ]
                },
                "setting": {
                  "additionalProperties": false,
                  "description": "UX2: 설정 바꾸기 제안 (Agent가 제안, 사람이 report.decide로 수락·거절). 팀 보고에는 ID·키·이유만 — 값·현재 값은 이 PC .kookabug/jobs/<작업>/proposals.json에만",
                  "properties": {
                    "id": {
                      "pattern": "^s-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
                      "type": "string"
                    },
                    "key": {
                      "enum": [
                        "automation.forbidden.add",
                        "cheats.categories.add",
                        "game.args",
                        "game.cwd",
                        "game.executable",
                        "game.title",
                        "sources.add"
                      ]
                    },
                    "reason": {
                      "maxLength": 2000,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": ["id", "key", "reason"],
                  "type": "object"
                },
                "summary": {
                  "additionalProperties": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "object"
                },
                "unknowns": {
                  "items": {
                    "pattern": "^u-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": ["kind"],
              "title": "ReportItem",
              "type": "object"
            },
            "type": "array"
          },
          "key": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["cause", "items", "key", "title"],
        "title": "ReportGroup",
        "type": "object"
      },
      "type": "array"
    },
    "job": {
      "pattern": "^j-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "playbook": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "rendered": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revisions": {
      "additionalProperties": false,
      "description": "생성 시점에 고정한 revision (렌더가 이 값을 쓴다 — 결정 뒤 다시 렌더해도 그대로)",
      "properties": {
        "claims": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": ["claims"],
      "type": "object"
    },
    "started_at": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "budget_exhausted",
        "cancelled",
        "done",
        "failed",
        "interrupted",
        "prep_failed",
        "running"
      ]
    },
    "trigger": {
      "enum": ["ci", "manual", "schedule"]
    },
    "unknowns": {
      "items": {
        "pattern": "^u-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": ["format", "groups", "job", "playbook", "started_at", "state", "trigger"],
  "title": "Report",
  "type": "object"
}
