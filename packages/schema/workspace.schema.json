{
  "$defs": {
    "CheatsPolicy": {
      "additionalProperties": false,
      "description": "M8: 치트 정책. 분류는 사용자 정의(제품 기본 분류 없음). 사람 전용 쓰기",
      "properties": {
        "categories": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "maxLength": 2000,
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "unattended": {
                "type": "boolean"
              }
            },
            "required": ["id", "title"],
            "title": "CheatCategory",
            "type": "object"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "title": "CheatsPolicy",
      "type": "object"
    },
    "OcrSettings": {
      "additionalProperties": false,
      "description": "OCR 엔진과 그 설정. engine이 없으면 rapidocr",
      "properties": {
        "det": {
          "additionalProperties": false,
          "description": "rapidocr 검출 크기 설정 (없는 값은 기본값)",
          "properties": {
            "limit_side_len": {
              "description": "짧은 변이 이보다 작을 때만 검출 입력을 늘린다. 기본 64",
              "minimum": 32,
              "type": "integer"
            },
            "max_side_len": {
              "description": "긴 변이 이보다 크면 줄인다. 기본 4096",
              "minimum": 256,
              "type": "integer"
            },
            "single_max_pixels": {
              "description": "픽셀 수가 이 이하면 한 번에 검출, 넘으면 타일로 나눈다. 기본 655360",
              "minimum": 65536,
              "type": "integer"
            },
            "tile_overlap": {
              "description": "이웃 타일이 겹치는 픽셀. 기본 128",
              "minimum": 0,
              "type": "integer"
            },
            "tile_side": {
              "description": "타일 한 변 (32의 배수). 기본 640",
              "minimum": 256,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "engine": {
          "enum": ["rapidocr"]
        }
      },
      "title": "OcrSettings",
      "type": "object"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "description": "권한 규칙 하나. rule은 \"도구\" 또는 \"도구(인자 패턴)\". 도구·인자 모두 glob(*, ?), 대소문자 구분",
      "properties": {
        "rule": {
          "pattern": "^[a-z0-9_*?]+(\\(.*\\))?$",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/PermissionVerdict"
        }
      },
      "required": ["rule", "verdict"],
      "title": "PermissionRule",
      "type": "object"
    },
    "PermissionVerdict": {
      "enum": ["allow", "ask", "deny"],
      "title": "PermissionVerdict"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "에이전트 권한. 이 파일(kookabug.json)의 툴셋·프리셋 값은 상한이다 (사용자·프로젝트 계층이 더 풀 수 없다)",
      "properties": {
        "preset": {
          "enum": [
            "curator",
            "explorer",
            "full",
            "graph_author",
            "qa_runner",
            "read_only",
            "runner"
          ]
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "type": "array"
        },
        "toolsets": {
          "additionalProperties": {
            "$ref": "#/$defs/PermissionVerdict"
          },
          "propertyNames": {
            "enum": [
              "cases",
              "control",
              "core",
              "graph_edit",
              "knowledge",
              "observe",
              "run",
              "screens"
            ]
          },
          "type": "object"
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "PluginIndex": {
      "additionalProperties": false,
      "description": "M6: 플러그인 의존성 인덱스. kookabug.json은 팀 공용, .kookabug/local.json의 같은 키가 개인 덮어쓰기. URL의 사용자 정보는 잠금·로그·화면에 남기지 않는다",
      "properties": {
        "find_links": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "PluginIndex",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      },
      "title": "Profile",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "description": "실행 기록 보관",
      "properties": {
        "failed_days": {
          "minimum": 0,
          "type": "integer"
        },
        "keep_last": {
          "minimum": 0,
          "type": "integer"
        },
        "passed_days": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "Retention",
      "type": "object"
    },
    "RunConditions": {
      "additionalProperties": false,
      "description": "실행 조건 기본값 (시간은 밀리초). CLI 옵션이 이 값보다 우선한다",
      "properties": {
        "capture_timeout_ms": {
          "description": "관측 호출(캡처·찾기·OCR) 하나의 설정 기한. 넘으면 capture_timeout. 없으면 2000",
          "minimum": 1,
          "type": "integer"
        },
        "deadline_ms": {
          "description": "실행 전체 기한. 없으면 30분",
          "minimum": 1,
          "type": "integer"
        },
        "frame_budget_mib": {
          "description": "프레임 저장소 바이트 예산 (MiB). 넘으면 스텝 출력으로 나간 프레임부터 버린다. 없으면 512",
          "minimum": 1,
          "type": "integer"
        },
        "frame_output_refs": {
          "description": "스텝 출력(이미지·찾기 결과)으로 나간 프레임을 남기는 개수. 없으면 32",
          "minimum": 0,
          "type": "integer"
        },
        "shutdown_grace_ms": {
          "description": "취소·마무리를 시작한 runner가 끝나기를 기다리는 시간. 넘으면 감독자가 끝낸다. 없으면 5000",
          "minimum": 1,
          "type": "integer"
        },
        "worker_cancel_grace_ms": {
          "description": "취소한 워커 노드가 끝나기를 기다리는 시간. 넘으면 워커를 끝낸다. 없으면 2000",
          "minimum": 1,
          "type": "integer"
        },
        "worker_start_timeout_ms": {
          "description": "워커가 시작 인사에 답하기까지의 기한. 없으면 30000",
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "RunConditions",
      "type": "object"
    },
    "SettingKey": {
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "title": "SettingKey",
      "type": "string"
    },
    "Settings": {
      "description": "설정 키 → 값. null은 사람마다 .kookabug/local.json에 넣어야 하는 값",
      "propertyNames": {
        "$ref": "#/$defs/SettingKey"
      },
      "title": "Settings",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "원본 하나. path·url·local 중 하나. local이면 경로는 .kookabug/local.json#sources.<id>.path",
      "oneOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["url"]
        },
        {
          "required": ["local"]
        }
      ],
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "type": "string"
        },
        "kind": {
          "enum": ["code", "data", "design_doc", "other", "patch_notes", "qa_sheet", "strings"]
        },
        "local": {
          "const": true
        },
        "path": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": ["id", "kind", "title"],
      "title": "Source",
      "type": "object"
    },
    "WorkspaceRecordPolicy": {
      "additionalProperties": false,
      "description": "워크스페이스 기록 정책: 그래프 RecordPolicy(screenshots·video)에 비밀값 가림 스위치를 더한 것. 상위에서 끈 것은 하위에서 켤 수 없다",
      "properties": {
        "redact_secrets": {
          "description": "비밀값 가림. true면 비밀값을 받은 스텝의 스크린샷·영상과 민감 target의 OCR 글자를 남기지 않고 이벤트·로그·실행 기록의 비밀값을 ***로 가린다. 없으면 false(개발 환경 도구라 그대로 남긴다)",
          "type": "boolean"
        },
        "screenshots": {
          "enum": ["off", "on"]
        },
        "video": {
          "enum": ["failed_only", "off", "on"]
        }
      },
      "title": "WorkspaceRecordPolicy",
      "type": "object"
    }
  },
  "$id": "urn:kookabug:workspace:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "팀 공용 워크스페이스 설정 (kookabug.json)",
  "properties": {
    "automation": {
      "$ref": "urn:kookabug:automation:0"
    },
    "cheats": {
      "$ref": "#/$defs/CheatsPolicy"
    },
    "format": {
      "const": "kookabug.workspace/0"
    },
    "id": {
      "description": "워크스페이스 ID (UUID 소문자). 자격 증명 관리자 비밀값 이름 kookabug:<ID>:<키>의 접두라 팀이 같은 값을 쓴다. 없으면 처음 비밀값을 만들 때(secrets.create) 만들어 넣는다 (M4)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "name": {
      "description": "M8: 프로젝트 이름 (마법사 1단계, kookabug workspace new --name)",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "ocr": {
      "$ref": "#/$defs/OcrSettings"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "plugin_index": {
      "$ref": "#/$defs/PluginIndex"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/Profile"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "type": "object"
    },
    "record": {
      "$ref": "#/$defs/WorkspaceRecordPolicy"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "run": {
      "$ref": "#/$defs/RunConditions"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "sources": {
      "description": "M8: 원본 위치 (복사하지 않는다). 사람 전용 쓰기(project.sources.set)",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "type": "array"
    }
  },
  "required": ["format"],
  "title": "Workspace",
  "type": "object"
}
