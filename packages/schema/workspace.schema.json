{
  "$defs": {
    "PermissionRule": {
      "additionalProperties": false,
      "description": "권한 규칙 하나. rule은 \"도구\" 또는 \"도구(인자 패턴)\". 도구·인자 모두 glob(*, ?), 대소문자 구분",
      "properties": {
        "rule": {
          "pattern": "^[a-z0-9_*?]+(\\(.*\\))?$",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/PermissionVerdict"
        }
      },
      "required": ["rule", "verdict"],
      "title": "PermissionRule",
      "type": "object"
    },
    "PermissionVerdict": {
      "enum": ["allow", "ask", "deny"],
      "title": "PermissionVerdict"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "에이전트 권한. 이 파일(kookabug.json)의 툴셋·프리셋 값은 상한이다 (사용자·프로젝트 계층이 더 풀 수 없다)",
      "properties": {
        "preset": {
          "enum": ["full", "graph_author", "read_only", "runner"]
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "type": "array"
        },
        "toolsets": {
          "additionalProperties": {
            "$ref": "#/$defs/PermissionVerdict"
          },
          "propertyNames": {
            "enum": ["control", "core", "graph_edit", "observe", "run", "screens"]
          },
          "type": "object"
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      },
      "title": "Profile",
      "type": "object"
    },
    "RecordPolicy": {
      "additionalProperties": false,
      "description": "기록 정책. 상위(워크스페이스 → 테스트 → 서브그래프 → 노드)에서 끈 것은 하위에서 켤 수 없다",
      "properties": {
        "screenshots": {
          "enum": ["off", "on"]
        },
        "video": {
          "enum": ["failed_only", "off", "on"]
        }
      },
      "title": "RecordPolicy",
      "type": "object"
    },
    "Retention": {
      "additionalProperties": false,
      "description": "실행 기록 보관",
      "properties": {
        "failed_days": {
          "minimum": 0,
          "type": "integer"
        },
        "keep_last": {
          "minimum": 0,
          "type": "integer"
        },
        "passed_days": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "Retention",
      "type": "object"
    },
    "SettingKey": {
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "title": "SettingKey",
      "type": "string"
    },
    "Settings": {
      "description": "설정 키 → 값. null은 사람마다 .kookabug/local.json에 넣어야 하는 값",
      "propertyNames": {
        "$ref": "#/$defs/SettingKey"
      },
      "title": "Settings",
      "type": "object"
    }
  },
  "$id": "urn:kookabug:workspace:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "팀 공용 워크스페이스 설정 (kookabug.json)",
  "properties": {
    "format": {
      "const": "kookabug.workspace/0"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/Profile"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "type": "object"
    },
    "record": {
      "$ref": "#/$defs/RecordPolicy"
    },
    "retention": {
      "$ref": "#/$defs/Retention"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": ["format"],
  "title": "Workspace",
  "type": "object"
}
