{
  "$defs": {
    "ExitName": {
      "pattern": "^[a-z_][a-z0-9_]*$",
      "title": "ExitName",
      "type": "string"
    },
    "Interface": {
      "additionalProperties": false,
      "description": "서브그래프의 공개 핀. inputs → 호출 노드 입력, exits → 출구, outputs → 출력",
      "properties": {
        "exits": {
          "additionalProperties": {
            "$ref": "#/$defs/InterfaceExit"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/ExitName"
          },
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/InterfaceInput"
          },
          "propertyNames": {
            "$ref": "#/$defs/PinName"
          },
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/InterfaceOutput"
          },
          "propertyNames": {
            "$ref": "#/$defs/PinName"
          },
          "type": "object"
        }
      },
      "required": ["exits"],
      "title": "Interface",
      "type": "object"
    },
    "InterfaceExit": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": ["fail", "ok"]
        },
        "screen": {
          "description": "이 출구로 나갔을 때 도착하는 화면 (화면 지도용)",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind"],
      "title": "InterfaceExit",
      "type": "object"
    },
    "InterfaceInput": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "description": "호출 노드가 값을 주지 않았을 때 쓰는 상수",
          "tsType": "unknown"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/PinType"
        }
      },
      "required": ["type"],
      "title": "InterfaceInput",
      "type": "object"
    },
    "InterfaceOutput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "nullable": {
          "description": "exit 노드가 주지 않으면 null로 채운다",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/PinType"
        }
      },
      "required": ["type"],
      "title": "InterfaceOutput",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "description": "편집기 배치. 실행에는 영향이 없다",
      "properties": {
        "collapsed": {
          "additionalProperties": {
            "$ref": "#/$defs/LayoutGroup"
          },
          "propertyNames": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "object"
        },
        "comments": {
          "additionalProperties": {
            "$ref": "#/$defs/LayoutComment"
          },
          "propertyNames": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "object"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/Position"
          },
          "propertyNames": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "object"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutComment": {
      "additionalProperties": false,
      "properties": {
        "rect": {
          "description": "[x, y, w, h]",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["rect", "text"],
      "title": "LayoutComment",
      "type": "object"
    },
    "LayoutGroup": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": ["nodes", "x", "y"],
      "title": "LayoutGroup",
      "type": "object"
    },
    "LinkRef": {
      "description": "노드ID.출력",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}\\.[a-z_][a-z0-9_]*$",
      "title": "LinkRef",
      "type": "string"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "type": "string"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "$ref": "#/$defs/NodeConfig"
        },
        "in": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "description": "입력 핀 값. 상수 또는 특수 값",
          "propertyNames": {
            "$ref": "#/$defs/PinName"
          },
          "type": "object"
        },
        "next": {
          "additionalProperties": {
            "$ref": "#/$defs/NodeId"
          },
          "description": "exec 연결: 출구 이름 → 다음 노드 ID",
          "propertyNames": {
            "$ref": "#/$defs/ExitName"
          },
          "type": "object"
        },
        "record": {
          "$ref": "#/$defs/RecordPolicy"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": ["type", "version"],
      "title": "Node",
      "type": "object"
    },
    "NodeConfig": {
      "additionalProperties": true,
      "description": "연결할 수 없는 노드 설정. 키는 노드 스키마가 정한다 (retry만 공통)",
      "properties": {
        "retry": {
          "$ref": "#/$defs/RetryConfig"
        }
      },
      "title": "NodeConfig",
      "type": "object"
    },
    "NodeId": {
      "description": "만들 때 정하고 바꾸지 않는다. $link가 '.'으로 노드와 출력을 나누므로 '.'을 쓸 수 없다",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
      "title": "NodeId",
      "type": "string"
    },
    "NodeType": {
      "description": "<플러그인>.<분류>.<동작>",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "NodeType",
      "type": "string"
    },
    "ObjectValue": {
      "description": "$로 시작하는 키가 있으면 특수 값, 없으면 일반 객체",
      "else": {
        "$ref": "#/$defs/SpecialValue"
      },
      "if": {
        "propertyNames": {
          "not": {
            "pattern": "^\\$"
          }
        }
      },
      "then": {
        "additionalProperties": {
          "$ref": "#/$defs/Value"
        }
      },
      "title": "ObjectValue",
      "tsType": "SpecialValue | { [key: string]: Value }",
      "type": "object"
    },
    "PinName": {
      "pattern": "^[a-z_][a-z0-9_]*$",
      "title": "PinName",
      "type": "string"
    },
    "PinType": {
      "description": "핀 타입: bool|int|float|string|secret|target|match|rect|point|image|window|process|any, list[T], dict[str,T], <플러그인>.<Type>, 유니온 A|B",
      "format": "kookabug-pin-type",
      "pattern": "^(list\\[|dict\\[str,)*(bool|int|float|string|secret|target|match|rect|point|image|window|process|any|[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9_]*)\\]*(\\|(list\\[|dict\\[str,)*(bool|int|float|string|secret|target|match|rect|point|image|window|process|any|[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9_]*)\\]*)*$",
      "title": "PinType",
      "type": "string"
    },
    "PluginId": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "PluginId",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": ["x", "y"],
      "title": "Position",
      "type": "object"
    },
    "RecordPolicy": {
      "additionalProperties": false,
      "description": "기록 정책. 상위(워크스페이스 → 테스트 → 서브그래프 → 노드)에서 끈 것은 하위에서 켤 수 없다",
      "properties": {
        "screenshots": {
          "enum": ["off", "on"]
        },
        "video": {
          "enum": ["failed_only", "off", "on"]
        }
      },
      "title": "RecordPolicy",
      "type": "object"
    },
    "RetryConfig": {
      "additionalProperties": false,
      "description": "노드 config.retry. 노드 스키마의 retry 선언 범위 안에서만 켠다",
      "properties": {
        "max_attempts": {
          "description": "첫 실행 포함",
          "minimum": 1,
          "type": "integer"
        },
        "on": {
          "description": "재시도할 fail 출구. 생략하면 노드 스키마의 retry.on 전부",
          "items": {
            "$ref": "#/$defs/ExitName"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["max_attempts"],
      "title": "RetryConfig",
      "type": "object"
    },
    "SecretKey": {
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "title": "SecretKey",
      "type": "string"
    },
    "SettingKey": {
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "title": "SettingKey",
      "type": "string"
    },
    "SpecialValue": {
      "description": "$로 시작하는 키 하나만 가진 객체. 닫힌 목록",
      "maxProperties": 1,
      "minProperties": 1,
      "properties": {
        "$link": {
          "$ref": "#/$defs/LinkRef"
        },
        "$literal": {
          "description": "해석하지 않고 그대로 쓰는 값",
          "tsType": "unknown"
        },
        "$secret": {
          "$ref": "#/$defs/SecretKey"
        },
        "$setting": {
          "$ref": "#/$defs/SettingKey"
        },
        "$target": {
          "$ref": "#/$defs/TargetPath"
        }
      },
      "propertyNames": {
        "enum": ["$link", "$literal", "$secret", "$setting", "$target"]
      },
      "title": "SpecialValue",
      "type": "object"
    },
    "TargetPath": {
      "description": "워크스페이스 루트 기준 *.target.json 경로 ('/' 구분)",
      "pattern": "^[^\\\\]+\\.target\\.json$",
      "title": "TargetPath",
      "type": "string"
    },
    "Value": {
      "anyOf": [
        {
          "type": ["boolean", "null", "number", "string"]
        },
        {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/ObjectValue"
        }
      ],
      "description": "in 핀 값: JSON 상수, 배열, 특수 값, $ 키가 없는 일반 객체. 특수 값은 배열·객체 안 어디든 올 수 있다",
      "title": "Value"
    }
  },
  "$id": "urn:kookabug:graph:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "테스트·서브그래프 그래프 파일 (*.graph.json). 테스트와 서브그래프는 같은 형식이고 kind만 다르다",
  "if": {
    "properties": {
      "kind": {
        "const": "subgraph"
      }
    },
    "required": ["kind"]
  },
  "properties": {
    "format": {
      "const": "kookabug.graph/0"
    },
    "interface": {
      "$ref": "#/$defs/Interface"
    },
    "kind": {
      "enum": ["subgraph", "test"]
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/Node"
      },
      "propertyNames": {
        "$ref": "#/$defs/NodeId"
      },
      "type": "object"
    },
    "plugins": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "description": "그래프가 쓰는 플러그인 ID → 버전",
      "propertyNames": {
        "$ref": "#/$defs/PluginId"
      },
      "type": "object"
    },
    "record": {
      "$ref": "#/$defs/RecordPolicy"
    }
  },
  "required": ["format", "kind", "nodes", "plugins"],
  "then": {
    "required": ["interface"]
  },
  "title": "Graph",
  "type": "object"
}
