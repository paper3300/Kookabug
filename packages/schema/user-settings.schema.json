{
  "$defs": {
    "PermissionRule": {
      "additionalProperties": false,
      "description": "권한 규칙 하나. rule은 \"도구\" 또는 \"도구(인자 패턴)\". 도구·인자 모두 glob(*, ?), 대소문자 구분",
      "properties": {
        "rule": {
          "pattern": "^[a-z0-9_*?]+(\\(.*\\))?$",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/PermissionVerdict"
        }
      },
      "required": ["rule", "verdict"],
      "title": "PermissionRule",
      "type": "object"
    },
    "PermissionVerdict": {
      "enum": ["allow", "ask", "deny"],
      "title": "PermissionVerdict"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "에이전트 권한 (사용자 계층). 모든 워크스페이스에 적용되고, 프로젝트 계층 값이 먼저다",
      "properties": {
        "preset": {
          "enum": ["full", "graph_author", "read_only", "runner"]
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "type": "array"
        },
        "toolsets": {
          "additionalProperties": {
            "$ref": "#/$defs/PermissionVerdict"
          },
          "propertyNames": {
            "enum": ["control", "core", "graph_edit", "observe", "run", "screens"]
          },
          "type": "object"
        }
      },
      "title": "Permissions",
      "type": "object"
    }
  },
  "$id": "urn:kookabug:user-settings:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "사용자 설정 (%APPDATA%\\Kookabug\\settings.json, 워크스페이스 밖)",
  "properties": {
    "format": {
      "const": "kookabug.user-settings/0"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    }
  },
  "required": ["format"],
  "title": "UserSettings",
  "type": "object"
}
