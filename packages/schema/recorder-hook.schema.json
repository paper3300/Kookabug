{
  "$defs": {
    "BadInputShape": {
      "anyOf": [
        {
          "anyOf": [
            {
              "required": ["button"]
            },
            {
              "required": ["delta"]
            },
            {
              "required": ["vk"]
            },
            {
              "required": ["scan"]
            },
            {
              "required": ["extended"]
            },
            {
              "required": ["horizontal"]
            },
            {
              "not": {
                "required": ["x", "y"]
              }
            }
          ],
          "properties": {
            "kind": {
              "const": "mouse_move"
            }
          },
          "required": ["kind"]
        },
        {
          "anyOf": [
            {
              "required": ["delta"]
            },
            {
              "required": ["vk"]
            },
            {
              "required": ["scan"]
            },
            {
              "required": ["extended"]
            },
            {
              "required": ["horizontal"]
            },
            {
              "not": {
                "required": ["button", "x", "y"]
              }
            }
          ],
          "properties": {
            "kind": {
              "enum": ["mouse_down", "mouse_up"]
            }
          },
          "required": ["kind"]
        },
        {
          "anyOf": [
            {
              "required": ["button"]
            },
            {
              "required": ["vk"]
            },
            {
              "required": ["scan"]
            },
            {
              "required": ["extended"]
            },
            {
              "not": {
                "required": ["delta", "x", "y"]
              }
            }
          ],
          "properties": {
            "kind": {
              "const": "wheel"
            }
          },
          "required": ["kind"]
        },
        {
          "anyOf": [
            {
              "required": ["x"]
            },
            {
              "required": ["y"]
            },
            {
              "required": ["button"]
            },
            {
              "required": ["delta"]
            },
            {
              "required": ["horizontal"]
            },
            {
              "not": {
                "required": ["extended", "scan", "vk"]
              }
            }
          ],
          "properties": {
            "kind": {
              "enum": ["key_down", "key_up"]
            }
          },
          "required": ["kind"]
        }
      ],
      "description": "입력 종류와 맞지 않는 필드 조합 (이 모양이면 틀린 입력 — HookEvent·RawInput이 not으로 쓴다). 이동은 x·y만, 버튼은 button·x·y, 휠은 delta·x·y(horizontal 선택), 키는 vk·scan·extended (좌표 없음)",
      "title": "BadInputShape"
    },
    "BatchNo": {
      "description": "hook.events 묶음 번호. 1부터 묶음마다 1씩 (전송 연속성). 빈 번호가 있으면 묶음을 잃은 것",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "BatchNo",
      "type": "integer"
    },
    "Count": {
      "description": "녹화 시작부터의 누적 개수",
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "CritSeq": {
      "description": "중요 이벤트(버튼·휠·키) 연속 번호. 우리 표식 제외를 통과한 중요 이벤트에만, 큐에 넣기 전에 1부터 매긴다. 큐가 차서 버린 이벤트도 번호를 쓰므로 받는 쪽의 빈 번호 = 실제 유실",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "CritSeq",
      "type": "integer"
    },
    "EventId": {
      "description": "훅 콜백이 받은 모든 원시 이벤트(이동·우리 표식 제외 포함)에 1부터 오르는 번호. 관측 연계(cause_event_id)·진단용이고 빈 번호가 정상이다 (빈틈 검사 안 함). 한 녹화 안에서 보내는 차례대로 커진다",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "EventId",
      "type": "integer"
    },
    "ExtraInfo": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^[0-9]+$",
          "type": "string"
        }
      ],
      "description": "dwExtraInfo (ULONG_PTR). 값 규칙(2^53-1) 안이면 정수, 넘으면 10진 문자열",
      "title": "ExtraInfo"
    },
    "Hkl": {
      "description": "자판 배치 핸들 HKL을 16진 소문자로 (예: 4120412, ffffffffe0010412)",
      "pattern": "^[0-9a-f]{1,16}$",
      "title": "Hkl",
      "type": "string"
    },
    "HookEvent": {
      "additionalProperties": false,
      "description": "저수준 훅 이벤트 하나 (MSLLHOOKSTRUCT·KBDLLHOOKSTRUCT 복사). 훅 콜백은 대상 창에 아무것도 묻지 않는다 — 창·자판·IME는 관측(ImmediateObs·ImeSample)으로 따로 온다. 이동(mouse_move)은 crit_seq가 없고 중요 이벤트는 반드시 있다. 종류별 필드는 BadInputShape(가짜 각본 RawInput과 공용)가 정한다",
      "not": {
        "anyOf": [
          {
            "$ref": "#/$defs/BadInputShape"
          },
          {
            "properties": {
              "kind": {
                "const": "mouse_move"
              }
            },
            "required": ["crit_seq", "kind"]
          },
          {
            "not": {
              "required": ["crit_seq"]
            },
            "properties": {
              "kind": {
                "enum": ["key_down", "key_up", "mouse_down", "mouse_up", "wheel"]
              }
            },
            "required": ["kind"]
          }
        ]
      },
      "properties": {
        "button": {
          "enum": ["left", "middle", "right", "x1", "x2"]
        },
        "crit_seq": {
          "$ref": "#/$defs/CritSeq"
        },
        "delta": {
          "description": "휠 한 번의 양 (WHEEL_DELTA 120 단위, 위·오른쪽이 양수)",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "extended": {
          "type": "boolean"
        },
        "extra_info": {
          "$ref": "#/$defs/ExtraInfo"
        },
        "horizontal": {
          "description": "가로 휠 (WM_MOUSEHWHEEL)이면 true",
          "type": "boolean"
        },
        "injected": {
          "description": "LLMHF_INJECTED·LLKHF_INJECTED",
          "type": "boolean"
        },
        "injected_lower_il": {
          "description": "LLMHF_LOWER_IL_INJECTED·LLKHF_LOWER_IL_INJECTED",
          "type": "boolean"
        },
        "kind": {
          "enum": ["key_down", "key_up", "mouse_down", "mouse_move", "mouse_up", "wheel"]
        },
        "scan": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "t_ns": {
          "$ref": "#/$defs/MonoNs"
        },
        "vk": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "y": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "required": ["event_id", "extra_info", "injected", "injected_lower_il", "kind", "t_ns"],
      "title": "HookEvent",
      "type": "object"
    },
    "HookEventsMessage": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "hook.events"
        },
        "params": {
          "$ref": "#/$defs/HookEventsParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "title": "HookEventsMessage",
      "type": "object"
    },
    "HookEventsParams": {
      "additionalProperties": false,
      "description": "hook.events (훅 → daemon): 이벤트 묶음 (최대 256개, event_id 차례). crit_first·crit_last = 이 묶음에 든 중요 이벤트의 첫·마지막 crit_seq (중요 이벤트가 없으면 둘 다 null). dropped_marker(우리 표식이라 훅 프로세스에서 버린 수)·coalesced_moves(이동 큐에서 덮어쓴 이동 수)·overflow(중요 큐가 차서 버린 중요 이벤트 수)는 녹화 시작부터의 누적. daemon 검사: batch_no가 이어지고, crit_seq가 묶음 안·사이에서 빈틈 없이 이어지고, overflow가 0. 어기면 녹화를 input_overflow로 멈춘다. event_id 빈틈·dropped_marker·coalesced_moves 증가는 정상",
      "else": {
        "properties": {
          "crit_last": {
            "$ref": "#/$defs/CritSeq"
          }
        }
      },
      "if": {
        "properties": {
          "crit_first": {
            "type": "null"
          }
        }
      },
      "properties": {
        "batch_no": {
          "$ref": "#/$defs/BatchNo"
        },
        "coalesced_moves": {
          "$ref": "#/$defs/Count"
        },
        "crit_first": {
          "anyOf": [
            {
              "$ref": "#/$defs/CritSeq"
            },
            {
              "type": "null"
            }
          ]
        },
        "crit_last": {
          "anyOf": [
            {
              "$ref": "#/$defs/CritSeq"
            },
            {
              "type": "null"
            }
          ]
        },
        "dropped_marker": {
          "$ref": "#/$defs/Count"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/HookEvent"
          },
          "maxItems": 256,
          "type": "array"
        },
        "overflow": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "batch_no",
        "coalesced_moves",
        "crit_first",
        "crit_last",
        "dropped_marker",
        "events",
        "overflow"
      ],
      "then": {
        "properties": {
          "crit_last": {
            "type": "null"
          }
        }
      },
      "title": "HookEventsParams",
      "type": "object"
    },
    "HookHealthMessage": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "hook.health"
        },
        "params": {
          "$ref": "#/$defs/HookHealthParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "title": "HookHealthMessage",
      "type": "object"
    },
    "HookHealthParams": {
      "additionalProperties": false,
      "description": "hook.health (훅 → daemon, 500 ms마다): 생존 보고. batch_no = 이 보고 전에 보낸 마지막 hook.events 번호(아직 없으면 0) — 같은 파이프로 차례대로 가므로 받은 마지막 묶음보다 크면 묶음을 잃은 것. last_event_ns = 훅 콜백이 마지막으로 받은 이벤트(우리 표식으로 버린 것 포함) 시각. last_input_tick = GetLastInputInfo().dwTime(ms 틱, 세션 전체·합성 포함) — 이것이 앞섰는데 1초 넘게 훅 이벤트가 없으면 OS가 훅을 뗀 것(hook_lost)",
      "properties": {
        "batch_no": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "last_event_ns": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonoNs"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_input_tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sent_at_ns": {
          "$ref": "#/$defs/MonoNs"
        }
      },
      "required": ["batch_no", "last_event_ns", "last_input_tick", "sent_at_ns"],
      "title": "HookHealthParams",
      "type": "object"
    },
    "HookHelloMessage": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "hook.hello"
        },
        "params": {
          "$ref": "#/$defs/HookHelloParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "title": "HookHelloMessage",
      "type": "object"
    },
    "HookHelloParams": {
      "additionalProperties": false,
      "description": "hook.hello (훅 → daemon): 파이프 인증 직후, 훅 둘을 건 뒤. mono_base_ns는 daemon이 띄울 때 준 녹화 기준 시각을 되돌려 준다(다르면 daemon이 거부). dpi_awareness는 진입점에서 켠 결과",
      "properties": {
        "created": {
          "description": "프로세스 생성 시각 (FILETIME 10진 문자열)",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "dpi_awareness": {
          "enum": ["per_monitor", "per_monitor_v2", "system", "unaware"]
        },
        "hooks": {
          "additionalProperties": false,
          "properties": {
            "keyboard": {
              "type": "boolean"
            },
            "mouse": {
              "type": "boolean"
            }
          },
          "required": ["keyboard", "mouse"],
          "type": "object"
        },
        "mono_base_ns": {
          "description": "녹화 기준 시각 = 그때의 time.monotonic_ns (10진 문자열). 모든 *_ns 값은 여기서 잰다",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "pid": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "protocol": {
          "const": 1
        }
      },
      "required": ["created", "dpi_awareness", "hooks", "mono_base_ns", "pid", "protocol"],
      "title": "HookHelloParams",
      "type": "object"
    },
    "HookImeMessage": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "hook.ime"
        },
        "params": {
          "additionalProperties": false,
          "description": "hook.ime (훅 → daemon): IME 모드 표본 묶음 (표본 시각 차례)",
          "properties": {
            "batch": {
              "items": {
                "$ref": "#/$defs/ImeSample"
              },
              "type": "array"
            }
          },
          "required": ["batch"],
          "title": "HookImeParams",
          "type": "object"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "title": "HookImeMessage",
      "type": "object"
    },
    "HookObsMessage": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "hook.obs"
        },
        "params": {
          "additionalProperties": false,
          "description": "hook.obs (훅 → daemon): 즉시 관측 묶음",
          "properties": {
            "batch": {
              "items": {
                "$ref": "#/$defs/ImmediateObs"
              },
              "type": "array"
            }
          },
          "required": ["batch"],
          "title": "HookObsParams",
          "type": "object"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "title": "HookObsMessage",
      "type": "object"
    },
    "HookStopMessage": {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "hook.stop"
        },
        "params": {
          "additionalProperties": false,
          "description": "hook.stop (daemon → 훅): 훅을 떼고 남은 묶음을 보낸 뒤 끝낸다",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "title": "HookStopParams",
          "type": "object"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "title": "HookStopMessage",
      "type": "object"
    },
    "Hwnd": {
      "description": "창 핸들 (정수)",
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Hwnd",
      "type": "integer"
    },
    "ImeSample": {
      "additionalProperties": false,
      "description": "IME 모드 표본. 관측 스레드만 대상 창에 묻는다: ImmGetDefaultIMEWnd → SendMessageTimeoutW(WM_IME_CONTROL, IMC_GETCONVERSIONMODE, SMTO_ABORTIFHUNG|SMTO_BLOCK, 50 ms). 조회는 query_started_ns에 시작해 sampled_at_ns에 끝났다. status가 ok면 mode는 alphanumeric(영문)·native(한글 등 입력기 고유 모드)이고 conversion(원래 비트)이 있다. ok가 아니면(timeout 시간 초과·failed 호출 실패·no_ime 입력기 창 없음) mode는 unknown. 키 시각 t의 모드 정하기 — '사이 변화'는 IME 전환 키·포그라운드·hkl 변경. (1) 앞 표본 S⁻ = t 앞 300 ms 안 마지막 ok 표본 중 S⁻~t 사이 변화 없음, 뒤 표본 S⁺ = t 뒤 300 ms 안 첫 ok 표본 중 t~S⁺ 사이 변화 없음. (2) 실패 표본의 무효화: 실패 표본의 조회 구간 [query_started_ns, sampled_at_ns]가 (S⁻ 시각, 없으면 t-300 ms) ~ (S⁺ 시각, 없으면 t+300 ms) 구간과 겹치면 그 키는 판정 불가 — 조회 실패를 건너뛰고 한쪽 정상 표본으로 확정하지 않는다. (3) 실패 없이 한쪽만 있으면 그 모드, 둘 다 있고 같으면 그 모드, 다르거나 둘 다 없으면 판정 불가. (4) ok 표본이라도 자기 조회 구간 안에 사이 변화가 있으면 어느 키에도 쓰지 않는다. 판정 불가 키가 든 입력 칸 구간은 needs_review(ime_unknown)",
      "else": {
        "not": {
          "required": ["conversion"]
        },
        "properties": {
          "mode": {
            "const": "unknown"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": ["status"]
      },
      "properties": {
        "conversion": {
          "description": "IMC_GETCONVERSIONMODE 결과 비트 (IME_CMODE_*)",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "fg": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hwnd"
            },
            {
              "type": "null"
            }
          ]
        },
        "fg_thread": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "hkl": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hkl"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": ["alphanumeric", "native", "unknown"]
        },
        "query_started_ns": {
          "$ref": "#/$defs/MonoNs"
        },
        "sampled_at_ns": {
          "$ref": "#/$defs/MonoNs"
        },
        "status": {
          "enum": ["failed", "no_ime", "ok", "timeout"]
        },
        "trigger": {
          "description": "표본을 뜬 까닭: key(키 뒤, 직전 표본이 100 ms보다 오래됨), ime_key(IME 전환 키를 뗀 직후), foreground·hkl(바뀜), periodic(대상이 앞에 있는 동안 250 ms마다)",
          "enum": ["foreground", "hkl", "ime_key", "key", "periodic"]
        }
      },
      "required": [
        "fg",
        "fg_thread",
        "hkl",
        "mode",
        "query_started_ns",
        "sampled_at_ns",
        "status",
        "trigger"
      ],
      "then": {
        "properties": {
          "mode": {
            "enum": ["alphanumeric", "native"]
          }
        },
        "required": ["conversion"]
      },
      "title": "ImeSample",
      "type": "object"
    },
    "ImmediateObs": {
      "additionalProperties": false,
      "description": "즉시 관측: 중요 이벤트 하나마다 하나(합치지 않음). 관측 스레드가 메시지 없는 API(GetForegroundWindow·GetWindowThreadProcessId·GetGUIThreadInfo·GetKeyboardLayout·GetWindowLongPtrW)와 창 이벤트로 갱신하는 Z 순서 표로 채운다. 읽지 못한 값은 null. table_changed_ns = 관측 시점 Z 순서·포그라운드 표가 마지막으로 바뀐 시각. daemon은 cause_event_id가 그 이벤트이고 |obs_at_ns - t_ns| ≤ 50 ms이고 table_changed_ns ≤ t_ns(이벤트 뒤 표가 바뀌지 않음)일 때만 쓴다 — 아니면 그 이벤트의 창 판정은 undetermined (확인 배지·needs_review, 추측으로 채우지 않음)",
      "properties": {
