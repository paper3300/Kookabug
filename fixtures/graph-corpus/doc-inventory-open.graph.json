{
  "format": "kookabug.graph/0",
  "kind": "test",
  "layout": {
    "nodes": {
      "n_check_inventory": {
        "x": 840,
        "y": 0
      },
      "n_enter_world": {
        "x": 0,
        "y": 0
      },
      "n_entry": {
        "x": -280,
        "y": 0
      },
      "n_press_i": {
        "x": 560,
        "y": 0
      },
      "n_skip_maintenance": {
        "x": 280,
        "y": 160
      },
      "n_use_window": {
        "x": 280,
        "y": 0
      }
    }
  },
  "meta": {
    "description": "월드에 들어간 뒤 I 키로 인벤토리 창이 열리는지 확인한다",
    "tags": ["inventory", "smoke"],
    "title": "인벤토리 열기"
  },
  "nodes": {
    "n_check_inventory": {
      "in": {
        "target": {
          "$target": "targets/inventory/window_title.target.json"
        },
        "timeout_ms": 5000
      },
      "title": "인벤토리 창 확인",
      "type": "core.assert.visible",
      "version": 1
    },
    "n_enter_world": {
      "config": {
        "graph": "subgraphs/enter_world.graph.json"
      },
      "in": {
        "account": "qa_tester_01",
        "password": {
          "$secret": "accounts.qa_tester_01"
        },
        "server": "Server 1"
      },
      "next": {
        "maintenance": "n_skip_maintenance",
        "success": "n_use_window"
      },
      "title": "월드 접속",
      "type": "core.graph.call",
      "version": 1
    },
    "n_entry": {
      "next": {
        "start": "n_enter_world"
      },
      "title": "시작",
      "type": "core.graph.entry",
      "version": 1
    },
    "n_press_i": {
      "in": {
        "keys": "I"
      },
      "next": {
        "done": "n_check_inventory"
      },
      "title": "I 키",
      "type": "core.input.key",
      "version": 1
    },
    "n_skip_maintenance": {
      "in": {
        "reason": "서버 점검 중"
      },
      "title": "점검이면 건너뜀",
      "type": "core.test.skip",
      "version": 1
    },
    "n_use_window": {
      "in": {
        "window": {
          "$link": "n_enter_world.window"
        }
      },
      "next": {
        "done": "n_press_i"
      },
      "title": "게임 창으로",
      "type": "core.window.set_current",
      "version": 1
    }
  },
  "plugins": {
    "core": "0.1.0"
  }
}
