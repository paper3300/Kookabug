{
  "format": "kookabug.fake-scenario/0",
  "forms": {
    "console": {
      "erase_key": "backspace",
      "expect": {
        "command": "give_gold 1000"
      },
      "fields": [
        {
          "name": "command",
          "rect": [24, 572, 976, 48]
        }
      ],
      "focus": "command",
      "input_scene": "console",
      "max_length": 40,
      "next_key": "tab",
      "scenes": ["console"]
    }
  },
  "launch": [
    {
      "args_contains": "--buy-moved",
      "variant": "moved"
    },
    {
      "args_contains": "--buy-missing",
      "variant": "missing"
    },
    {
      "variant": "default"
    }
  ],
  "process": {
    "name": "python.exe"
  },
  "scenes": {
    "boot": "boot.png",
    "console": "console.png",
    "shop": "shop.png",
    "shop_bought": "shop_bought.png",
    "shop_closed": "shop_closed.png",
    "shop_missing": "shop_missing.png",
    "shop_missing_sold": "shop_missing_sold.png",
    "shop_moved": "shop_moved.png",
    "shop_moved_bought": "shop_moved_bought.png",
    "shop_moved_sold": "shop_moved_sold.png",
    "shop_purchase_confirm": "shop_purchase_confirm.png",
    "shop_rich": "shop_rich.png",
    "shop_sold": "shop_sold.png"
  },
  "start": "boot",
  "transitions": [
    {
      "after_frames": 0,
      "from": "boot",
      "to": "shop",
      "variants": ["default"]
    },
    {
      "after_frames": 0,
      "from": "boot",
      "to": "shop_moved",
      "variants": ["moved"]
    },
    {
      "after_frames": 0,
      "from": "boot",
      "to": "shop_missing",
      "variants": ["missing"]
    },
    {
      "after_frames": 0,
      "from": "console",
      "on": {
        "key": "enter",
        "kind": "key"
      },
      "to": "shop_rich",
      "variants": ["default"],
      "when": {
        "form": "console",
        "valid": true
      }
    },
    {
      "after_frames": 0,
      "from": "console",
      "on": {
        "key": "enter",
        "kind": "key"
      },
      "to": "shop",
      "variants": ["default"],
      "when": {
        "form": "console",
        "valid": false
      }
    },
    {
      "after_frames": 0,
      "from": "console",
      "on": {
        "key": "esc",
        "kind": "key"
      },
      "to": "shop",
      "variants": ["default"]
    },
    {
