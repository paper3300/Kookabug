{
  "format": "kookabug.graph/0",
  "kind": "test",
  "meta": {
    "description": "기준 버튼을 찾은 뒤 창 크기를 바꾸고 그 찾은 결과로 누른다. 입력 서비스가 다시 찾아 누르거나(log에 남음) stale_observation으로 끝나야 한다",
    "tags": ["m1-manual"],
    "title": "크기 변경 뒤 클릭"
  },
  "nodes": {
    "n_attach": {
      "in": {
        "title": {
          "$setting": "game.title"
        }
      },
      "next": {
        "found": "n_wait_anchor"
      },
      "title": "게임 창 붙기",
      "type": "core.window.attach",
      "version": 1
    },
    "n_click": {
      "in": {
        "match": {
          "$link": "n_wait_anchor.match"
        }
      },
      "next": {
        "done": "n_read"
      },
      "title": "기준 버튼 클릭",
      "type": "core.input.click",
      "version": 1
    },
    "n_entry": {
      "next": {
        "start": "n_attach"
      },
      "title": "시작",
      "type": "core.graph.entry",
      "version": 1
    },
    "n_pass": {
      "title": "통과",
      "type": "core.test.pass",
      "version": 1
    },
    "n_read": {
      "in": {
        "contains": {
          "$setting": "check.text"
        },
        "region": {
          "$target": "targets/label.target.json"
        },
        "timeout_ms": 10000
      },
      "next": {
        "found": "n_pass"
      },
      "title": "확인 글자 읽기",
      "type": "core.ocr.wait_text",
      "version": 1
    },
    "n_resize": {
      "in": {
        "client_size": {
          "$setting": "resize.size"
        }
      },
      "next": {
        "done": "n_click"
      },
      "title": "창 크기 바꾸기",
      "type": "core.window.set_size",
      "version": 1
    },
    "n_wait_anchor": {
      "in": {
        "target": {
          "$target": "targets/anchor.target.json"
        },
        "timeout_ms": 10000
      },
      "next": {
        "found": "n_resize"
      },
      "title": "기준 버튼 대기",
      "type": "core.image.wait",
      "version": 1
    }
  },
  "plugins": {
    "core": "0.1.0"
  }
}
