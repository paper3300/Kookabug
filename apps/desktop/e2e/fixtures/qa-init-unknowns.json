{
  "description": "M8 인수 E2E(test_wizard_to_init): 5단계 연결 시험은 kb_project_info 한 번으로 끝내고(앱 E2E 훅은 시험과 Init에 같은 명령을 쓴다), 9단계 Init은 설정 확인(6단계에서 넣은 없는 원본 = missing) → 잠깐 머묾(보고함에 진행 중이 보이게) → 미지수 2개(사람만 답할 수 있는 것 1개 + Agent가 더 알아볼 것 1개) → 보고 메모",
  "steps": [
    {"label": "probe_info", "tool": "kb_project_info"},
    {"exit": 0, "if_playbook": "probe"},
    {
      "label": "info",
      "tool": "kb_project_info",
      "check": {"job.job": "${job}", "sources.[id=data_table].state": "missing"}
    },
    {"sleep": 8},
    {"toolsets": ["knowledge", "cases"]},
    {
      "label": "unknowns",
      "tool": "kb_knowledge_apply",
      "args": {
        "request_id": "e2e-init-unknowns",
        "ops": [
          {"op": "add", "file": "unknowns", "base_revision": 0, "item": {
            "question": "데이터 테이블(data_table)은 어디에 있나요?", "human_only": true, "blocks": [],
            "how": "6단계에서 경로를 고친다", "source": "sources:data_table"}},
          {"op": "add", "file": "unknowns", "base_revision": 0, "item": {
            "question": "상점 화면이 몇 개인가", "human_only": false, "blocks": [],
            "how": "게임을 탐색한다", "source": null}}
        ]
      },
      "check": {"applied": true}
    },
    {"label": "note", "tool": "kb_report_note", "args": {"text": "Init: 읽지 못한 원본 1개, 미지수 2개(사람만 답할 수 있는 것 1개)."}}
  ]
}
