{
  "$defs": {
    "CancelParams": {
      "additionalProperties": false,
      "description": "cancel 알림 (runner → 워커): 이후 ctx 호출·sleep·check_cancel이 Cancelled",
      "title": "CancelParams",
      "type": "object"
    },
    "ControlState": {
      "description": "runner 상태 (제어 요청의 응답): running 실행 중, pausing 다음 경계에서 멈출 것, paused 멈춤, cancelling 취소 순서 진행 중",
      "enum": ["cancelling", "paused", "pausing", "running"],
      "title": "ControlState",
      "type": "string"
    },
    "ControlStateResult": {
      "additionalProperties": false,
      "description": "run.cancel·run.pause·run.resume (감독자 → runner)의 결과. 노드가 실행 중이어도 받는 즉시 답한다",
      "properties": {
        "state": {
          "$ref": "#/$defs/ControlState"
        }
      },
      "required": ["state"],
      "title": "ControlStateResult",
      "type": "object"
    },
    "CtxArtifactsSaveParams": {
      "additionalProperties": false,
      "description": "ctx.artifacts.save (워커 → runner)",
      "properties": {
        "image": {
          "$ref": "#/$defs/WireValue"
        },
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["image", "invoke", "name"],
      "title": "CtxArtifactsSaveParams",
      "type": "object"
    },
    "CtxArtifactsSaveResult": {
      "additionalProperties": false,
      "description": "실행 폴더 기준 경로. 기록 정책으로 생략하면 null",
      "properties": {
        "path": {
          "type": ["string", "null"]
        }
      },
      "required": ["path"],
      "title": "CtxArtifactsSaveResult",
      "type": "object"
    },
    "CtxCaptureParams": {
      "additionalProperties": false,
      "description": "ctx.capture (워커 → runner)",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "region": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["invoke", "region"],
      "title": "CtxCaptureParams",
      "type": "object"
    },
    "CtxCaptureResult": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["image"],
      "title": "CtxCaptureResult",
      "type": "object"
    },
    "CtxInputClickParams": {
      "additionalProperties": false,
      "description": "ctx.input.click (워커 → runner). at은 point·rect·match",
      "properties": {
        "at": {
          "$ref": "#/$defs/WireValue"
        },
        "button": {
          "type": "string"
        },
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        }
      },
      "required": ["at", "button", "invoke"],
      "title": "CtxInputClickParams",
      "type": "object"
    },
    "CtxInputKeyParams": {
      "additionalProperties": false,
      "description": "ctx.input.key (워커 → runner)",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "key": {
          "type": "string"
        }
      },
      "required": ["invoke", "key"],
      "title": "CtxInputKeyParams",
      "type": "object"
    },
    "CtxInputTypeTextParams": {
      "additionalProperties": false,
      "description": "ctx.input.type_text (워커 → runner). text는 문자열이나 비밀값",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "text": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["invoke", "text"],
      "title": "CtxInputTypeTextParams",
      "type": "object"
    },
    "CtxLogParams": {
      "additionalProperties": false,
      "description": "ctx.log (워커 → runner). message는 str()로 만든 것(비밀값은 가려짐)",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "level": {
          "enum": ["debug", "info", "warn", "error"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["invoke", "level", "message"],
      "title": "CtxLogParams",
      "type": "object"
    },
    "CtxSettingParams": {
      "additionalProperties": false,
      "description": "ctx.setting (워커 → runner)",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "key": {
          "type": "string"
        }
      },
      "required": ["invoke", "key"],
      "title": "CtxSettingParams",
      "type": "object"
    },
    "CtxSettingResult": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["value"],
      "title": "CtxSettingResult",
      "type": "object"
    },
    "CtxVarsGetParams": {
      "additionalProperties": false,
      "description": "ctx.vars.get·has (워커 → runner)",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["invoke", "name"],
      "title": "CtxVarsGetParams",
      "type": "object"
    },
    "CtxVarsGetResult": {
      "additionalProperties": false,
      "properties": {
        "found": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["found", "value"],
      "title": "CtxVarsGetResult",
      "type": "object"
    },
    "CtxVarsSetParams": {
      "additionalProperties": false,
      "description": "ctx.vars.set (워커 → runner)",
      "properties": {
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["invoke", "name", "value"],
      "title": "CtxVarsSetParams",
      "type": "object"
    },
    "EmptyResult": {
      "additionalProperties": false,
      "description": "결과 없음 (ctx.log·ctx.vars.set·ctx.input.*·worker.shutdown)",
      "title": "EmptyResult",
      "type": "object"
    },
    "ErrorCode": {
      "description": "표준: -32700 parse_error, -32600 invalid_request, -32601 method_not_found, -32602 invalid_params, -32603 internal_error. Kookabug: -32001 cancelled, -32002 node_error, -32003 context_violation, -32004 node_contract, -32005 protocol_version",
      "enum": [-32700, -32600, -32601, -32602, -32603, -32001, -32002, -32003, -32004, -32005],
      "title": "ErrorCode",
      "type": "integer"
    },
    "ErrorObject": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "data": {
          "description": "오류별 추가 정보 (node_error: 예외 이름·메시지·traceback)",
          "tsType": "unknown"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"],
      "title": "ErrorObject",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorObject"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "요청을 읽지 못했으면(JSON 아님·id 없음) null"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        }
      },
      "required": ["error", "id", "jsonrpc"],
      "title": "ErrorResponse",
      "type": "object"
    },
    "InvokeId": {
      "description": "노드 실행 번호 (runner가 워커마다 1부터 붙인다). 워커의 ctx 요청은 자기를 부른 node.invoke의 번호를 싣고, runner는 지금 기다리는 실행의 번호가 아니면 처리하지 않는다(context_violation)",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "InvokeId",
      "type": "integer"
    },
    "JsonRpcVersion": {
      "const": "2.0",
      "title": "JsonRpcVersion"
    },
    "MethodName": {
      "description": "점으로 나눈 소문자 이름 (예: node.invoke, run.cancel)",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "title": "MethodName",
      "type": "string"
    },
    "NodeInvokeParams": {
      "additionalProperties": false,
      "description": "node.invoke (runner → 워커): 노드 하나 실행. pure·effects는 runner가 아는 선언(워커 선언과 다르면 node_contract), deadline_remaining_ms는 테스트 전체 기한까지 남은 시간",
      "properties": {
        "config": {
          "$ref": "#/$defs/WireValue"
        },
        "deadline_remaining_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "effects": {
          "items": {
            "enum": ["capture", "input", "process"]
          },
          "type": "array"
        },
        "inputs": {
          "$ref": "#/$defs/WireValue"
        },
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "node_id": {
          "type": "string"
        },
        "pure": {
          "type": "boolean"
        },
        "step": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": [
        "config",
        "deadline_remaining_ms",
        "effects",
        "inputs",
        "invoke",
        "node_id",
        "pure",
        "step",
        "type",
        "window"
      ],
      "title": "NodeInvokeParams",
      "type": "object"
    },
    "NodeInvokeResult": {
      "additionalProperties": false,
      "description": "노드 결과. 순수 노드는 exit·kind가 null. 오류는 오류 응답(cancelled·node_error·context_violation·node_contract)",
      "properties": {
        "exit": {
          "type": ["string", "null"]
        },
        "kind": {
          "enum": ["ok", "fail", null]
        },
        "message": {
          "type": ["string", "null"]
        },
        "outputs": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": ["exit", "kind", "message", "outputs"],
      "title": "NodeInvokeResult",
      "type": "object"
    },
    "Notification": {
      "additionalProperties": false,
      "description": "응답이 없는 알림 (예: 취소)",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "$ref": "#/$defs/MethodName"
        },
        "params": {
          "$ref": "#/$defs/Params"
        }
      },
      "required": ["jsonrpc", "method"],
      "title": "Notification",
      "type": "object"
    },
    "Params": {
      "additionalProperties": true,
      "description": "이름 있는 인자만 쓴다 (배열 params는 쓰지 않는다)",
      "title": "Params",
      "type": "object"
    },
    "ProcessIdent": {
      "additionalProperties": false,
      "description": "프로세스 식별 (PID + 생성 시각). created는 Windows FILETIME(100ns 단위)을 10진 문자열로 — RPC 정수 범위(2^53)를 넘는다",
      "properties": {
        "created": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "pid": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["created", "pid"],
      "title": "ProcessIdent",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "description": "응답을 기다리는 요청",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "$ref": "#/$defs/MethodName"
        },
        "params": {
          "$ref": "#/$defs/Params"
        }
      },
      "required": ["id", "jsonrpc", "method"],
      "title": "Request",
      "type": "object"
    },
    "RequestId": {
      "description": "보낸 쪽이 1부터 붙이는 요청 번호. 응답은 같은 번호로 짝짓는다 (양쪽이 따로 센다)",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "RequestId",
      "type": "integer"
    },
    "RunSpec": {
      "additionalProperties": false,
      "description": "실행 사양: 감독자가 runner의 stdin에 JSON 하나로 주고 닫는다 (제어 채널 키를 명령줄·실행 폴더에 남기지 않는다). 시간 값을 빼면 runner 기본값(취소 유예 2000, 워커 시작 30000, 마무리 유예 5000, 자기 종료 여유 10000 ms)",
      "properties": {
        "control": {
          "additionalProperties": false,
          "description": "제어 채널: 감독자가 연 파이프 이름과 상호 인증 키(32바이트 hex)",
          "properties": {
            "key": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "pipe": {
              "type": "string"
            }
          },
          "required": ["key", "pipe"],
          "type": "object"
        },
        "deadline_ms": {
          "description": "테스트 전체 기한 (runner 시작부터)",
          "minimum": 1,
          "type": "integer"
        },
        "graph": {
          "description": "실행할 테스트 그래프 (워크스페이스 기준 경로)",
          "type": "string"
        },
        "job_name": {
          "description": "감독자가 만든 실행 Job 이름. runner는 어떤 자식도 띄우기 전에 자기를 넣는다",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/RunSpecPlatform"
        },
        "plugin_modules": {
          "description": "워커가 import할 플러그인 모듈 (개발용 --plugin-module). 비면 워커를 띄우지 않는다",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "type": ["null", "string"]
        },
        "run_dir": {
          "description": "감독자가 만든 실행 폴더 (절대 경로)",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-z0-9]{8}$",
          "type": "string"
        },
        "self_kill_margin_ms": {
          "description": "감독자가 살아 있을 때 자기 종료 감시자가 마무리 유예 뒤 더 기다리는 시간 (내부 값, 사용자 설정 아님)",
          "minimum": 0,
          "type": "integer"
        },
        "settings": {
          "description": "--set 설정값 (옵션 계층)",
          "type": "object"
        },
        "shutdown_grace_ms": {
          "description": "마무리 유예: 감독자 하드 종료·감독자 사망 뒤 자기 종료까지",
          "minimum": 0,
          "type": "integer"
        },
        "supervisor": {
          "$ref": "#/$defs/ProcessIdent"
        },
        "worker_cancel_grace_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "worker_start_timeout_ms": {
          "minimum": 1,
          "type": "integer"
        },
        "workspace_root": {
          "type": "string"
        }
      },
      "required": [
        "control",
        "deadline_ms",
        "graph",
        "job_name",
        "platform",
        "plugin_modules",
        "profile",
        "run_dir",
        "run_id",
        "settings",
        "supervisor",
        "workspace_root"
      ],
      "title": "RunSpec",
      "type": "object"
    },
    "RunSpecPlatform": {
      "additionalProperties": false,
      "description": "플랫폼: none(캡처·입력 없음) 또는 fake(frames를 차례로 캡처, 입력은 input_log JSONL에 기록, hooks는 가짜 백엔드의 키별 훅)",
      "properties": {
        "frames": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hooks": {
          "additionalProperties": false,
          "properties": {
            "after_down": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "before_down": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "before_up": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "input_log": {
          "type": "string"
        },
        "kind": {
          "enum": ["fake", "none"]
        }
      },
      "required": ["kind"],
      "title": "RunSpecPlatform",
      "type": "object"
    },
    "RunnerHelloParams": {
      "additionalProperties": false,
      "description": "runner.hello (runner → 감독자): 제어 채널에 붙은 직후. runner는 자기 식별을 스스로 알린다 (venv 런처를 거쳐 띄웠어도 실제 runner 프로세스)",
      "properties": {
        "protocol": {
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "runner": {
          "$ref": "#/$defs/ProcessIdent"
        }
      },
      "required": ["protocol", "run_id", "runner"],
      "title": "RunnerHelloParams",
      "type": "object"
    },
    "RunnerStoppingParams": {
      "additionalProperties": false,
      "description": "runner.stopping 알림 (runner → 감독자): 종료 단계에 들어갔다 (정상 마무리 finish 또는 취소 사유). 감독자는 처음 받은 때부터 마무리 유예가 지나도 runner가 살아 있으면 하드 종료한다 — 외부 취소 없이 기한 초과·정상 마무리에서 멈춘 runner도 같은 규칙",
      "properties": {
        "reason": {
          "enum": ["cancelled", "deadline_exceeded", "finish", "supervisor_lost"]
        }
      },
      "required": ["reason"],
      "title": "RunnerStoppingParams",
      "type": "object"
    },
    "SuccessResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "description": "메서드별 결과 (JSON 값)",
          "tsType": "unknown"
        }
      },
      "required": ["id", "jsonrpc", "result"],
      "title": "SuccessResponse",
      "type": "object"
    },
    "WireValue": {
      "description": "노드 입력·출력·ctx 값 (kookabug_sdk.codec). JSON 값은 그대로, SDK 타입은 {\"$kb\": 태그, ...}(secret·rect·point·window·process·image·match·target), $kb 키를 가진 사용자 객체는 {\"$kb\": \"dict\", \"value\": ...}",
      "title": "WireValue",
      "tsType": "unknown"
    },
    "WorkerHelloParams": {
      "additionalProperties": false,
      "description": "worker.hello (runner → 워커): 프로토콜, import할 플러그인 모듈, 실행 ID, 원본 워크스페이스(표시용), ctx.path() 루트(실행 스냅샷)",
      "properties": {
        "files_root": {
          "type": "string"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol": {
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": ["files_root", "modules", "protocol", "run_id", "workspace_id"],
      "title": "WorkerHelloParams",
      "type": "object"
    },
    "WorkerHelloResult": {
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "items": {
            "$ref": "#/$defs/WorkerPlugin"
          },
          "type": "array"
        },
        "protocol": {
          "type": "integer"
        }
      },
      "required": ["plugins", "protocol"],
      "title": "WorkerHelloResult",
      "type": "object"
    },
    "WorkerPlugin": {
      "additionalProperties": false,
      "description": "워커가 읽은 플러그인 하나. schema는 노드 스키마 문서(node-schema.schema.json)",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["id", "schema", "version"],
      "title": "WorkerPlugin",
      "type": "object"
    }
  },
  "$id": "urn:kookabug:rpc:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
