          "$ref": "#/$defs/JsonRpcVersion"
        }
      },
      "required": ["error", "id", "jsonrpc"],
      "title": "ErrorResponse",
      "type": "object"
    },
    "InvokeId": {
      "description": "노드 실행 번호 (runner가 워커마다 1부터 붙인다). 워커의 ctx 요청은 자기를 부른 node.invoke의 번호를 싣고, runner는 지금 기다리는 실행의 번호가 아니면 처리하지 않는다(context_violation)",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "InvokeId",
      "type": "integer"
    },
    "JsonRpcVersion": {
      "const": "2.0",
      "title": "JsonRpcVersion"
    },
    "MethodName": {
      "description": "점으로 나눈 소문자 이름 (예: node.invoke, run.cancel)",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "title": "MethodName",
      "type": "string"
    },
    "Millis": {
      "description": "시간 길이 (밀리초, 0 이상)",
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Millis",
      "type": "integer"
    },
    "NodeInvokeParams": {
      "additionalProperties": false,
      "description": "node.invoke (runner → 워커): 노드 하나 실행. pure·effects는 runner가 아는 선언(워커 선언과 다르면 node_contract), deadline_remaining_ms는 테스트 전체 기한까지 남은 시간",
      "properties": {
        "config": {
          "$ref": "#/$defs/WireValue"
        },
        "deadline_remaining_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "effects": {
          "items": {
            "enum": ["capture", "input", "process"]
          },
          "type": "array"
        },
        "inputs": {
          "$ref": "#/$defs/WireValue"
        },
        "invoke": {
          "$ref": "#/$defs/InvokeId"
        },
        "node_id": {
          "type": "string"
        },
        "pure": {
          "type": "boolean"
        },
        "step": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": [
        "config",
        "deadline_remaining_ms",
        "effects",
        "inputs",
        "invoke",
        "node_id",
        "pure",
        "step",
        "type",
        "window"
      ],
      "title": "NodeInvokeParams",
      "type": "object"
    },
    "NodeInvokeResult": {
      "additionalProperties": false,
      "description": "노드 결과. 순수 노드는 exit·kind가 null. 오류는 오류 응답(cancelled·node_error·context_violation·node_contract)",
      "properties": {
        "exit": {
          "type": ["string", "null"]
        },
        "kind": {
          "enum": ["ok", "fail", null]
        },
        "message": {
          "anyOf": [
            {
              "type": ["string", "null"]
            },
            {
              "$ref": "#/$defs/SecretMessageWire"
