{
  "$defs": {
    "Conditions": {
      "additionalProperties": false,
      "description": "실행 조건",
      "properties": {
        "deadline_ms": {
          "minimum": 1,
          "type": "integer"
        },
        "platform": {
          "description": "플랫폼 종류 (none·fake·windows)",
          "type": "string"
        },
        "profile": {
          "type": ["null", "string"]
        },
        "settings": {
          "additionalProperties": {
            "$ref": "#/$defs/SettingUse"
          },
          "description": "이 실행이 쓴 $setting 키 → 값·계층. 비밀값은 키만",
          "propertyNames": {
            "$ref": "#/$defs/SettingKey"
          },
          "type": "object"
        }
      },
      "required": ["deadline_ms", "platform", "profile", "settings"],
      "title": "Conditions",
      "type": "object"
    },
    "DebugInfo": {
      "additionalProperties": false,
      "description": "디버거 개입 정보 (스키마 v0 6장)",
      "properties": {
        "debug_intervened": {
          "description": "디버거가 개입한 실행",
          "type": "boolean"
        },
        "pause_count": {
          "minimum": 0,
          "type": "integer"
        },
        "paused_ms": {
          "description": "멈춰 있던 시간 (M3부터 기한에서 뺀다)",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "DebugInfo",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "file": {
          "type": ["null", "string"]
        },
        "message": {
          "type": "string"
        },
        "node": {
          "type": ["null", "string"]
        },
        "pointer": {
          "type": ["null", "string"]
        },
        "severity": {
          "enum": ["error", "warning"]
        }
      },
      "required": ["code", "message", "severity"],
      "title": "Diagnostic",
      "type": "object"
    },
    "FinalizedBy": {
      "description": "실행을 마무리한 쪽: runner 자신, 또는 runner가 죽은 뒤 감독자",
      "enum": ["runner", "supervisor"],
      "title": "FinalizedBy",
      "type": "string"
    },
    "Plugin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["id", "version"],
      "title": "Plugin",
      "type": "object"
    },
    "RunId": {
      "description": "실행 ID: 소문자·숫자 8자",
      "pattern": "^[a-z0-9]{8}$",
      "title": "RunId",
      "type": "string"
    },
    "RunnerInfo": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "minimum": 0,
          "type": "integer"
        },
        "python": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["pid", "python", "version"],
      "title": "RunnerInfo",
      "type": "object"
    },
    "SettingKey": {
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
      "title": "SettingKey",
      "type": "string"
    },
    "SettingUse": {
      "additionalProperties": false,
      "description": "설정값과 그 값을 준 계층. 비밀값(secret: true)은 값을 남기지 않는다",
      "not": {
        "required": ["secret", "value"]
      },
      "properties": {
        "layer": {
          "enum": ["local", "options", "profile", "workspace"]
        },
        "secret": {
          "const": true
        },
        "value": {}
      },
      "required": ["layer"],
      "title": "SettingUse",
      "type": "object"
    },
    "Timestamp": {
      "description": "UTC 시각, 밀리초까지 (2026-10-29T06:02:11.104Z)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Timestamp",
      "type": "string"
    },
    "Verdict": {
      "enum": ["error", "fail", "pass", "skipped"],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "urn:kookabug:run:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "실행 정보·결과 (실행 폴더의 run.json). 원자적 교체로만 쓴다",
  "else": {
    "not": {
      "anyOf": [
        {
          "required": ["ended_at"]
        },
        {
          "required": ["verdict"]
        },
        {
          "required": ["finalized_by"]
        }
      ]
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "finished"
      }
    },
    "required": ["status"]
  },
  "properties": {
    "code": {
      "type": "string"
    },
    "conditions": {
      "$ref": "#/$defs/Conditions"
    },
    "debug_intervened": {
      "description": "디버거가 개입한 실행",
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    },
    "ended_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "failure_path": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_step": {
      "type": ["null", "string"]
    },
    "finalized_by": {
      "$ref": "#/$defs/FinalizedBy"
    },
    "format": {
      "const": "kookabug.run/0"
    },
    "game_build": {
      "type": ["null", "string"]
    },
    "graph": {
      "description": "실행한 테스트 그래프 (워크스페이스 기준)",
      "type": "string"
    },
    "packages": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "패키지 이름 → 버전",
      "type": "object"
    },
    "pause_count": {
      "minimum": 0,
      "type": "integer"
    },
    "paused_ms": {
      "description": "멈춰 있던 시간 (M3부터 기한에서 뺀다)",
      "minimum": 0,
      "type": "integer"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/Plugin"
      },
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "run_json_repaired": {
      "const": true,
      "description": "감독자가 run.end에서 다시 만든 파일"
    },
    "runner": {
      "$ref": "#/$defs/RunnerInfo"
    },
    "runner_exit_code": {
      "type": "integer"
    },
    "started_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "status": {
      "enum": ["finished", "running"]
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": ["format", "graph", "run_id", "started_at", "status"],
  "then": {
    "required": [
      "code",
      "ended_at",
      "failure_path",
      "failure_step",
      "finalized_by",
      "reason",
      "verdict"
    ]
  },
  "title": "Run",
  "type": "object"
}
