{
  "$defs": {
    "AttemptEndEvent": {
      "additionalProperties": false,
      "description": "재시도할 중간 시도의 실패. 판정에는 들어가지 않는다",
      "properties": {
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "const": "attempt.end"
        },
        "exit": {
          "type": ["null", "string"]
        },
        "iteration": {
          "description": "반복 안 스텝의 회차 (0부터)",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "outputs": {
          "type": "object"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "status": {
          "const": "fail"
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "attempt",
        "duration_ms",
        "event",
        "exit",
        "outputs",
        "run",
        "seq",
        "status",
        "step",
        "t"
      ],
      "title": "AttemptEndEvent",
      "type": "object"
    },
    "CallPath": {
      "description": "호출 경로: 테스트부터의 호출 노드들 + 노드",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "CallPath",
      "type": "array"
    },
    "CancelReason": {
      "description": "취소 사유: 외부 취소, 테스트 전체 기한 초과, 감독자 사망",
      "enum": ["cancelled", "deadline_exceeded", "supervisor_lost"],
      "title": "CancelReason",
      "type": "string"
    },
    "CancelRequestedEvent": {
      "additionalProperties": false,
      "description": "runner가 취소 순서를 시작했다",
      "properties": {
        "event": {
          "const": "cancel.requested"
        },
        "reason": {
          "$ref": "#/$defs/CancelReason"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "reason", "run", "seq", "t"],
      "title": "CancelRequestedEvent",
      "type": "object"
    },
    "ControlLostEvent": {
      "additionalProperties": false,
      "description": "제어 채널이 끊겼다. 감독자는 살아 있으므로 취소가 아니다",
      "properties": {
        "error": {
          "type": "string"
        },
        "event": {
          "const": "control.lost"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "run", "seq", "t"],
      "title": "ControlLostEvent",
      "type": "object"
    },
    "DebugPauseEvent": {
      "additionalProperties": false,
      "description": "멈춤 확정",
      "properties": {
        "event": {
          "const": "debug.pause"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "run", "seq", "t"],
      "title": "DebugPauseEvent",
      "type": "object"
    },
    "DebugResumeEvent": {
      "additionalProperties": false,
      "description": "재개",
      "properties": {
        "event": {
          "const": "debug.resume"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "run", "seq", "t"],
      "title": "DebugResumeEvent",
      "type": "object"
    },
    "FinalizedBy": {
      "description": "실행을 마무리한 쪽: runner 자신, 또는 runner가 죽은 뒤 감독자",
      "enum": ["runner", "supervisor"],
      "title": "FinalizedBy",
      "type": "string"
    },
    "InputDownEvent": {
      "additionalProperties": false,
      "description": "입력 액터가 백엔드에 누르기를 보내기 전에 쓴다",
      "else": {
        "not": {
          "required": ["key"]
        },
        "required": ["button"]
      },
      "if": {
        "properties": {
          "device": {
            "const": "keyboard"
          }
        }
      },
      "properties": {
        "button": {
          "minLength": 1,
          "type": "string"
        },
        "device": {
          "enum": ["keyboard", "mouse"]
        },
        "event": {
          "const": "input.down"
        },
        "key": {
          "minLength": 1,
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["device", "event", "run", "seq", "t"],
      "then": {
        "not": {
          "required": ["button"]
        },
        "required": ["key"]
      },
      "title": "InputDownEvent",
      "type": "object"
    },
    "InputRecoveredEvent": {
      "additionalProperties": false,
      "description": "앞 실행(from_run)에서 눌렸을 수 있는 키·버튼을 뗐다",
      "properties": {
        "by": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["runner", "supervisor"]
            },
            "run": {
              "$ref": "#/$defs/RunId"
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        "event": {
          "const": "input.recovered"
        },
        "from_run": {
          "$ref": "#/$defs/RunId"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "type": "array"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["by", "event", "from_run", "inputs", "run", "seq", "t"],
      "title": "InputRecoveredEvent",
      "type": "object"
    },
    "InputRecovery": {
      "description": "눌렸을 수 있는 키 복구 결과: 복구함, 다른 쪽이 이미 복구함(복구 표시 파일), 복구할 키 없음, 임대권을 얻지 못함, 복구 수단 없음",
      "enum": ["already_recovered", "lease_busy", "not_needed", "recovered", "unavailable"],
      "title": "InputRecovery",
      "type": "string"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "키보드 키 또는 마우스 버튼",
      "else": {
        "not": {
          "required": ["key"]
        },
        "required": ["button"]
      },
      "if": {
        "properties": {
          "device": {
            "const": "keyboard"
          }
        }
      },
      "properties": {
        "button": {
          "minLength": 1,
          "type": "string"
        },
        "device": {
          "enum": ["keyboard", "mouse"]
        },
        "key": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["device"],
      "then": {
        "not": {
          "required": ["button"]
        },
        "required": ["key"]
      },
      "title": "InputRef",
      "type": "object"
    },
    "InputUpEvent": {
      "additionalProperties": false,
      "description": "입력 액터가 백엔드에 떼기를 보낸 뒤에 쓴다",
      "else": {
        "not": {
          "required": ["key"]
        },
        "required": ["button"]
      },
      "if": {
        "properties": {
          "device": {
            "const": "keyboard"
          }
        }
      },
      "properties": {
        "button": {
          "minLength": 1,
          "type": "string"
        },
        "device": {
          "enum": ["keyboard", "mouse"]
        },
        "event": {
          "const": "input.up"
        },
        "key": {
          "minLength": 1,
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["device", "event", "run", "seq", "t"],
      "then": {
        "not": {
          "required": ["button"]
        },
        "required": ["key"]
      },
      "title": "InputUpEvent",
      "type": "object"
    },
    "LogEvent": {
      "additionalProperties": false,
      "description": "노드·runner 로그",
      "properties": {
        "event": {
          "const": "log"
        },
        "level": {
          "enum": ["debug", "error", "info", "warn"]
        },
        "message": {
          "type": "string"
        },
        "node": {
          "type": ["null", "string"]
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "level", "message", "node", "run", "seq", "step", "t"],
      "title": "LogEvent",
      "type": "object"
    },
    "Omitted": {
      "additionalProperties": false,
      "description": "정책으로 남기지 않은 증거와 그 이유",
      "properties": {
        "kind": {
          "description": "증거 종류 (screenshot 등)",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "enum": ["capture_policy", "policy_off", "secret_input"]
        },
        "source": {
          "description": "정책을 끈 곳",
          "type": "string"
        }
      },
      "required": ["kind", "reason"],
      "title": "Omitted",
      "type": "object"
    },
    "ProcessInfo": {
      "additionalProperties": false,
      "properties": {
        "created": {
          "description": "프로세스 생성 시각 (Unix 기준 UTC 마이크로초). PID 재사용을 가린다",
          "minimum": 0,
          "type": "integer"
        },
        "pid": {
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["created", "pid", "version"],
      "title": "ProcessInfo",
      "type": "object"
    },
    "RunEndEvent": {
      "additionalProperties": false,
      "description": "실행 결과. runner가 쓰거나, runner가 죽으면 감독자가 쓴다 (runner_died)",
      "properties": {
        "cancel_reason": {
          "$ref": "#/$defs/CancelReason"
        },
        "code": {
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "event": {
          "const": "run.end"
        },
        "failure_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "finalized_by": {
          "$ref": "#/$defs/FinalizedBy"
        },
        "input_recovery": {
          "$ref": "#/$defs/InputRecovery"
        },
        "reason": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "runner_exit_code": {
          "type": "integer"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        },
        "truncated_bytes": {
          "description": "감독자가 마무리 전에 잘라 낸 저널 끝 바이트 수",
          "minimum": 0,
          "type": "integer"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "code",
        "duration_ms",
        "event",
        "failure_path",
        "failure_step",
        "finalized_by",
        "reason",
        "run",
        "seq",
        "t",
        "verdict"
      ],
      "title": "RunEndEvent",
      "type": "object"
    },
    "RunId": {
      "description": "실행 ID: 소문자·숫자 8자",
      "pattern": "^[a-z0-9]{8}$",
      "title": "RunId",
      "type": "string"
    },
    "RunStartEvent": {
      "additionalProperties": false,
      "description": "실행 시작. runner가 저널의 첫 줄로 쓴다",
      "properties": {
        "event": {
          "const": "run.start"
        },
        "graph": {
          "description": "실행한 테스트 그래프 (워크스페이스 기준)",
          "type": "string"
        },
        "protocol": {
          "minimum": 1,
          "type": "integer"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "runner": {
          "$ref": "#/$defs/ProcessInfo"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "graph", "protocol", "run", "runner", "seq", "t"],
      "title": "RunStartEvent",
      "type": "object"
    },
    "Seq": {
      "description": "저널 안 순번. 1부터 빈틈 없이",
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "StepEndEvent": {
      "additionalProperties": false,
      "description": "스텝 결과. 이 줄이 없는 스텝은 중단된 것이다",
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"],
          "type": "object"
        },
        "event": {
          "const": "step.end"
        },
        "exit": {
          "type": ["null", "string"]
        },
        "graph": {
          "description": "서브그래프 호출이면 이번 실행에 쓴 스냅샷 파일",
          "type": "string"
        },
        "iteration": {
          "description": "반복 안 스텝의 회차 (0부터)",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "omitted": {
          "items": {
            "$ref": "#/$defs/Omitted"
          },
          "type": "array"
        },
        "outputs": {
          "type": "object"
        },
        "retried": {
          "const": true
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "status": {
          "enum": ["cancelled", "error", "fail", "success"]
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "attempt",
        "duration_ms",
        "event",
        "exit",
        "outputs",
        "run",
        "seq",
        "status",
        "step",
        "t"
      ],
      "title": "StepEndEvent",
      "type": "object"
    },
    "StepId": {
      "pattern": "^s[1-9][0-9]*$",
      "title": "StepId",
      "type": "string"
    },
    "StepStartEvent": {
      "additionalProperties": false,
      "description": "스텝 시작. 재시도해도 스텝 하나에 한 번",
      "properties": {
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "event": {
          "const": "step.start"
        },
        "iteration": {
          "description": "반복 안 스텝의 회차 (0부터)",
          "minimum": 0,
          "type": "integer"
        },
        "node": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/CallPath"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "step": {
          "$ref": "#/$defs/StepId"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["attempt", "event", "node", "parent", "path", "run", "seq", "step", "t"],
      "title": "StepStartEvent",
      "type": "object"
    },
    "Timestamp": {
      "description": "UTC 시각, 밀리초까지 (2026-10-29T06:02:11.104Z)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Timestamp",
      "type": "string"
    },
    "Verdict": {
      "enum": ["error", "fail", "pass", "skipped"],
      "title": "Verdict",
      "type": "string"
    },
    "WorkerExitEvent": {
      "additionalProperties": false,
      "description": "워커 프로세스 종료",
      "properties": {
        "event": {
          "const": "worker.exit"
        },
        "exit_code": {
          "type": "integer"
        },
        "pid": {
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "enum": ["killed_after_grace", "shutdown", "start_timeout", "unexpected"]
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "pid", "run", "seq", "t"],
      "title": "WorkerExitEvent",
      "type": "object"
    },
    "WorkerStartEvent": {
      "additionalProperties": false,
      "description": "워커 프로세스 시작",
      "properties": {
        "event": {
          "const": "worker.start"
        },
        "pid": {
          "minimum": 0,
          "type": "integer"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "$ref": "#/$defs/Seq"
        },
        "t": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": ["event", "pid", "run", "seq", "t"],
      "title": "WorkerStartEvent",
      "type": "object"
    }
  },
  "$id": "urn:kookabug:events:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "events.jsonl 한 줄 (실행 이벤트 하나). event 값으로 종류를 고른다",
  "oneOf": [
    {
      "$ref": "#/$defs/RunStartEvent"
    },
    {
      "$ref": "#/$defs/StepStartEvent"
    },
    {
      "$ref": "#/$defs/AttemptEndEvent"
    },
    {
      "$ref": "#/$defs/StepEndEvent"
    },
    {
      "$ref": "#/$defs/LogEvent"
    },
    {
      "$ref": "#/$defs/InputDownEvent"
    },
    {
      "$ref": "#/$defs/InputUpEvent"
    },
    {
      "$ref": "#/$defs/InputRecoveredEvent"
    },
    {
      "$ref": "#/$defs/CancelRequestedEvent"
    },
    {
      "$ref": "#/$defs/ControlLostEvent"
    },
    {
      "$ref": "#/$defs/DebugPauseEvent"
    },
    {
      "$ref": "#/$defs/DebugResumeEvent"
    },
    {
      "$ref": "#/$defs/WorkerStartEvent"
    },
    {
      "$ref": "#/$defs/WorkerExitEvent"
    },
    {
      "$ref": "#/$defs/RunEndEvent"
    }
  ],
  "title": "Event"
}
