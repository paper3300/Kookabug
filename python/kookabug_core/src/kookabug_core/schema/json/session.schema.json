{
  "$defs": {
    "Timestamp": {
      "description": "UTC 시각, 밀리초까지 (2026-10-29T06:02:11.104Z)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "$id": "urn:kookabug:session:0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": ".kookabug/session.json: 워크스페이스 daemon 하나의 접속 정보. daemon이 .kookabug/daemon.lock을 쥔 뒤 임시 파일 + replace로 쓰고, 끝날 때 자기 start_id인 경우에만 지운다. 판단 근거는 잠금이고, pid·process_created는 붙기 전에 보는 빠른 확인이다",
  "properties": {
    "daemon_version": {
      "minLength": 1,
      "type": "string"
    },
    "format": {
      "const": "kookabug.session/0"
    },
    "pid": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "port": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "process_created": {
      "description": "daemon 프로세스 생성 시각: Windows FILETIME(100ns 단위)을 10진 문자열로",
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "protocol": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "start_id": {
      "description": "daemon이 시작할 때 정한 무작위 ID (16바이트 hex). 바뀌면 daemon이 교체된 것",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "started_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "token": {
      "description": "session.hello 인증 토큰 (32바이트 hex)",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "workspace": {
      "description": "워크스페이스 루트 절대 경로",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "daemon_version",
    "format",
    "pid",
    "port",
    "process_created",
    "protocol",
    "start_id",
    "started_at",
    "token",
    "workspace"
  ],
  "title": "Session",
  "type": "object"
}
