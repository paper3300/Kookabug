

@node(
    type="__ID__.value.pick",
    version=1,
    title="값 고르기",
    category="__ID__",
    # 인스펙터에서 ui/index.js의 "choice" 위젯으로 고친다
    config={"value": Config(str, default="a", description="고른 값", ui=Widget("choice"))},
    exits=[Exit("done", "ok")],
    outputs={"value": str},
)
def pick(ctx: Context) -> Result:
    """설정한 값을 출력한다."""
    return Result.ok("done", value=str(ctx.config["value"]))
